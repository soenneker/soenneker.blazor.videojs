<Card>
    <CardHeader>
        <Div Display="Display.Flex" Flex=@("flex-wrap") AlignUtility="Align.ItemsCenter.JustifyBetween" Gap="Gap.Is2">
            <Div Space="Space.Y.Is1">
                <H3 Margin="Margin.Is0">@Title</H3>
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <Paragraph Margin="Margin.Is0" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                        @Description
                    </Paragraph>
                }
            </Div>
            @if (HeaderExtra != null)
            {
                @HeaderExtra
            }
        </Div>
    </CardHeader>

    <CardBody>
        <Div Space="Space.Y.Is4">
            @ChildContent
        </Div>
    </CardBody>
</Card>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? HeaderExtra { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
